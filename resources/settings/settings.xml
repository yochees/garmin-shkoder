<settings>

    <setting propertyKey="@Properties.LeadingZero" title="@Strings.SettLeadingZero">
        <settingConfig type="boolean"/>
    </setting>

    <setting propertyKey="@Properties.LeftField" title="@Strings.SettLeftField">
        <settingConfig type="list">
            <listEntry value="0">@Strings.FieldOff</listEntry>
            <listEntry value="1">@Strings.FieldDate</listEntry>
            <listEntry value="2">@Strings.FieldSteps</listEntry>
            <listEntry value="3">@Strings.FieldBattery</listEntry>
            <listEntry value="4">@Strings.FieldCalories</listEntry>
            <listEntry value="5">@Strings.FieldDistance</listEntry>
            <listEntry value="6">@Strings.FieldNotifications</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.RightField" title="@Strings.SettRightField">
        <settingConfig type="list">
            <listEntry value="0">@Strings.FieldOff</listEntry>
            <listEntry value="1">@Strings.FieldDate</listEntry>
            <listEntry value="2">@Strings.FieldSteps</listEntry>
            <listEntry value="3">@Strings.FieldBattery</listEntry>
            <listEntry value="4">@Strings.FieldCalories</listEntry>
            <listEntry value="5">@Strings.FieldDistance</listEntry>
            <listEntry value="6">@Strings.FieldNotifications</listEntry>
        </settingConfig>
    </setting>
</settings>
